<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Destock.App.Controls"
             x:Class="Destock.App.Views.ChangePasswordPage"
             Title="Mot de passe">

    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="18,12,18,24" Spacing="16">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Changer le mot de passe" Style="{StaticResource PageTitle}" />
                    <Label Text="Sécurisez votre accès à Destock."
                           Style="{StaticResource PageSubtitle}" />
                </VerticalStackLayout>

                <Border IsVisible="{Binding HasError}" BackgroundColor="{StaticResource DangerBg}"
                        StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="12,10">
                    <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}"
                           FontFamily="InterMedium" FontSize="12.5" />
                </Border>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="14">
                        <controls:FormEntry FieldLabel="Mot de passe actuel"
                                            Text="{Binding OldPassword}"
                                            Placeholder="••••••" IsPassword="True" MaxLength="80" />

                        <controls:FormEntry FieldLabel="Nouveau mot de passe"
                                            Text="{Binding NewPassword}"
                                            Placeholder="4 caractères minimum" IsPassword="True" MaxLength="80" />

                        <controls:FormEntry FieldLabel="Confirmer le nouveau mot de passe"
                                            Text="{Binding ConfirmPassword}"
                                            Placeholder="Répétez le nouveau mot de passe"
                                            IsPassword="True" MaxLength="80" />
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="{AppThemeBinding Light={StaticResource WarningBg}, Dark=#2C2314}"
                        StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="14,11">
                    <HorizontalStackLayout Spacing="9">
                        <Image Source="key.png" HeightRequest="15" WidthRequest="15"
                               VerticalOptions="Start" Margin="0,1,0,0" />
                        <Label Text="Le mot de passe initial est admin123. Changez-le dès la première utilisation."
                               FontFamily="Inter" FontSize="11.5"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    </HorizontalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="1"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}"
                StrokeThickness="0" StrokeShape="Rectangle" Padding="18,12,18,20">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Button Text="Modifier le mot de passe" Command="{Binding SaveCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                <ActivityIndicator Grid.Column="1" IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}" VerticalOptions="Center" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
